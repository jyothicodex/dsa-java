// Problem: Move Zeroes
// LeetCode: 283
// Pattern: Two Pointers
// Time Complexity: O(n)
// Space Complexity: O(1)
//link:https://leetcode.com/problems/move-zeroes/description/

class Solution {
    public void moveZeroes(int[] nums) {
        int i = 0;  

        for (int j = 0; j < nums.length; j++) {
            if (nums[j] != 0) {

                // Swap nums[i] and nums[j]
                int temp = nums[i];
                nums[i] = nums[j];
                nums[j] = temp;

                i++; 
            }
        }
    }
}
