// Problem: 2016. Maximum Difference Between Increasing Elements
// Platform: LeetCode
// Pattern: Minimum Tracking
// Time Complexity: O(n)
// Space Complexity: O(1)
// Link: https://leetcode.com/problems/maximum-difference-between-increasing-elements/

class Solution {
    public int maximumDifference(int[] nums) {
        int maximumDifference = -1;
        int min = nums[0];

        for(int num : nums){ 
            int diff = num - min;

            if(diff > 0){
                maximumDifference = Math.max(maximumDifference, diff);
            }

            min = Math.min(min, num);
        }

        return maximumDifference;
    }
}
